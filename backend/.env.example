DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=lte_scanner
DATABASE_USER=lte_scanner
DATABASE_PASSWORD=engen1us
DATABASE_SCHEMA=app

GPS_PROVIDER=mock
DEFAULT_TTY=/dev/ttyUSB0
SCAN_TIMEOUT=30

# CLI command for lte-discovery scanner
# Set full path for systemd service: /home/pi/.local/bin/lte-discovery
CLI_COMMAND=lte-discovery

# Enable mock mode for development without real hardware
# When true, returns simulated scan results instead of calling actual CLI tool
MOCK_CLI=false

LOG_LEVEL=INFO

APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

TIMEZONE=Asia/Jakarta
