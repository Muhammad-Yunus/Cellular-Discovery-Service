# Production Environment Variables
# Contoh ini siap dijalankan untuk production (Raspberry Pi + GPS hardware)
# Salin ke .env dan sesuaikan dengan konfigurasi hardware Anda

# PostgreSQL Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=lte_scanner
DATABASE_USER=lte_scanner
DATABASE_PASSWORD=engen1us
DATABASE_SCHEMA=app

# GPS Provider Configuration
# ============================================================
# Pilihan GPS_PROVIDER:
#   - "cli"        : Menggunakan CLI tool (disarankan untuk production)
#                    Requires: CLI_COMMAND, DEFAULT_TTY
#                    Contoh: /home/pi/GPS/build/gps
#   - "serial"     : Menggunakan direct serial connection
#                    Requires: DEFAULT_TTY (e.g., /dev/ttyUSB0)
#                   适合: GPS module dengan NMEA output
#   - "mock"       : Mock GPS untuk testing/development
#                    Returns: Fixed Jakarta coordinates (-6.15, 106.90)
#                    ONLY untuk testing, JANGAN untuk production!
# ============================================================
GPS_PROVIDER=cli

# CLI GPS Configuration (untuk GPS_PROVIDER=cli)
# CLI_COMMAND: path ke executable GPS CLI tool
CLI_COMMAND=/home/pi/GPS/build/gps

# DEFAULT_TTY: path ke port serial GPS
# - /dev/ttyAMA0: GPIO UART (GPS HAT)
# - /dev/ttyUSB0: USB GPS module
DEFAULT_TTY=/dev/ttyAMA0

# Serial GPS Configuration (alternatif untuk GPS_PROVIDER=serial)
# DEFAULT_TTY=/dev/ttyUSB0
# SCAN_TIMEOUT=30

# Mission Configuration
MISSION_POLL_INTERVAL=2
MISSION_GPS_FAILURE_THRESHOLD=10
MISSION_CLI_TIMEOUT=30
MISSION_START_GPS_TIMEOUT=5
MISSION_LOG_SIZE=200
MISSION_DEFAULT_RADIUS_METERS=20
MISSION_MAX_LOCATIONS=10000

# Logging
LOG_LEVEL=INFO

# Application
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# Timezone
TIMEZONE=Asia/Jakarta

# CORS
ALLOW_ALL_ORIGINS=true
ORIGIN_WHITELIST=""
