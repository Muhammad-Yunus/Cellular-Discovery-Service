# Production Environment Variables
# Contoh ini siap dijalankan untuk production (Raspberry Pi + GPS hardware)
# Salin ke .env dan sesuaikan dengan konfigurasi hardware Anda

# PostgreSQL Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=lte_scanner
DATABASE_USER=lte_scanner
DATABASE_PASSWORD=<your_password>
DATABASE_SCHEMA=app

# GPS Provider Configuration
# ============================================================
# Pilihan GPS_PROVIDER:
#   - "cli"        : Menggunakan CLI tool (disarankan untuk production)
#                    Requires: GPS_CLI_COMMAND, DEFAULT_GPS_TTY
#   - "mock"       : Mock GPS untuk testing/development
#                    Returns: Fixed Jakarta coordinates (-6.15, 106.90)
#                    ONLY untuk testing, JANGAN untuk production!
#   - "moving_mock": Simulasi drone bergerak antar waypoint (test mode)
#                    Requires: MOCK_GPS_START_LAT, MOCK_GPS_START_LON
#                    Optional: MOCK_GPS_WAYPOINTS, MOCK_GPS_LOITER_RADIUS
# ============================================================
GPS_PROVIDER=cli

# Moving Mock GPS Configuration (untuk GPS_PROVIDER=moving_mock)
# Simulasi drone terbang dari start -> waypoints -> kembali ke start,
# dengan loitering 2-3x di setiap waypoint sebelum lanjut.
# Waypoints format: lat,lon:lat,lon:lat,lon
MOCK_GPS_START_LAT=-6.150677
MOCK_GPS_START_LON=106.896652
MOCK_GPS_WAYPOINTS=
MOCK_GPS_LOITER_RADIUS_M=20.0
MOCK_GPS_SPEED_MS=50.0
MOCK_GPS_LOITER_LAPS=3

# GPS CLI Configuration (untuk GPS_PROVIDER=cli)
# GPS_CLI_COMMAND: path ke executable GPS CLI tool
# GPS HAT di /dev/ttyAMA0 membutuhkan tool ini untuk baca koordinat
GPS_CLI_COMMAND=/home/pi/GPS/build/gps

# DEFAULT_GPS_TTY: port serial GPS HAT di GPIO UART Raspberry Pi
DEFAULT_GPS_TTY=/dev/ttyAMA0

# GPS CLI tuning
GPS_CLI_BAUD=9600
GPS_CLI_TIMEOUT=60
GPS_CLI_COUNT=10

# Scan Configuration
SCAN_TIMEOUT=90

# Mission Configuration
MISSION_POLL_INTERVAL=2
MISSION_GPS_FAILURE_THRESHOLD=10
MISSION_CLI_TIMEOUT=30
MISSION_START_GPS_TIMEOUT=5
MISSION_LOG_SIZE=200
MISSION_DEFAULT_RADIUS_METERS=20
MISSION_MAX_LOCATIONS=10000

# Multi-scan during loiter settings
MISSION_SCAN_INTERVAL_SEC=8.0
MISSION_SCAN_MAX_PER_TOWER=100
MISSION_SCAN_MIN_FOR_VISITED=4

# LTE Scanner CLI Command (lte-scan for RTL-SDR)
# Use this for the LTE scan tool, not the GPS tool
LTE_SCAN_COMMAND=lte-scan
LTE_SCAN_BANDS=8
LTE_SCAN_GAIN_DB=43
LTE_SCAN_MODE=balance

# Logging
LOG_LEVEL=INFO

# Application
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# Timezone
TIMEZONE=Asia/Jakarta

# CORS settings - enable to allow frontend from any origin during development
ALLOW_ALL_ORIGINS=true

# Comma-separated list of allowed origins if ALLOW_ALL_ORIGINS is false
# Example: http://localhost:3000,http://192.168.1.50:3000,https://yourdomain.com
ORIGIN_WHITELIST=""
