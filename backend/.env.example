DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=lte_scanner
DATABASE_USER=lte_scanner
DATABASE_PASSWORD=engen1us
DATABASE_SCHEMA=app

GPS_PROVIDER=mock
DEFAULT_TTY=/dev/ttyUSB0
SCAN_TIMEOUT=30

# CLI command for lte-discovery scanner
# Set full path if running as systemd service where PATH may not include user bin
CLI_COMMAND=lte-discovery

LOG_LEVEL=INFO

APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

TIMEZONE=Asia/Jakarta
