DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=lte_scanner
DATABASE_USER=lte_scanner
DATABASE_PASSWORD=engen1us
DATABASE_SCHEMA=app

GPS_PROVIDER=mock
DEFAULT_TTY=/dev/ttyUSB0
SCAN_TIMEOUT=30

# CLI command for lte-discovery scanner
# Set full path for systemd service: /home/pi/.local/bin/lte-discovery
CLI_COMMAND=lte-discovery

MISSION_POLL_INTERVAL=2
MISSION_GPS_FAILURE_THRESHOLD=10
MISSION_CLI_TIMEOUT=30
MISSION_START_GPS_TIMEOUT=5
MISSION_LOG_SIZE=200
MISSION_DEFAULT_RADIUS_METERS=20
MISSION_MAX_LOCATIONS=10000

LOG_LEVEL=INFO

APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

TIMEZONE=Asia/Jakarta
