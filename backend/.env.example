# Production Environment Variables
# Contoh ini siap dijalankan untuk production (Raspberry Pi + GPS hardware)
# Salin ke .env dan sesuaikan dengan konfigurasi hardware Anda

# PostgreSQL Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=lte_scanner
DATABASE_USER=lte_scanner
DATABASE_PASSWORD=engen1us
DATABASE_SCHEMA=app

# GPS Provider Configuration
# ============================================================
# Pilihan GPS_PROVIDER:
#   - "cli"        : Menggunakan CLI tool (disarankan untuk production)
#                    Requires: GPS_CLI_COMMAND, DEFAULT_GPS_TTY
#   - "mock"       : Mock GPS untuk testing/development
#                    Returns: Fixed Jakarta coordinates (-6.15, 106.90)
#                    ONLY untuk testing, JANGAN untuk production!
# ============================================================
GPS_PROVIDER=cli

# GPS CLI Configuration (untuk GPS_PROVIDER=cli)
# GPS_CLI_COMMAND: path ke executable GPS CLI tool
# GPS HAT di /dev/ttyAMA0 membutuhkan tool ini untuk baca koordinat
GPS_CLI_COMMAND=/home/pi/GPS/build/gps

# DEFAULT_GPS_TTY: port serial GPS HAT di GPIO UART Raspberry Pi
DEFAULT_GPS_TTY=/dev/ttyAMA0

# SCAN_TIMEOUT=30

# Mission Configuration
MISSION_POLL_INTERVAL=2
MISSION_GPS_FAILURE_THRESHOLD=10
MISSION_CLI_TIMEOUT=30
MISSION_START_GPS_TIMEOUT=5
MISSION_LOG_SIZE=200
MISSION_DEFAULT_RADIUS_METERS=20
MISSION_MAX_LOCATIONS=10000

# LTE Scanner CLI Command (separate from GPS CLI)
# Use this for the lte-discovery scanner tool, not the GPS tool
LTE_DISCOVERY_COMMAND=/home/pi/.local/bin/lte-discovery

# Logging
LOG_LEVEL=INFO

# Application
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# Timezone
TIMEZONE=Asia/Jakarta

# CORS
ALLOW_ALL_ORIGINS=true
ORIGIN_WHITELIST=""
